{
  "name": "@lumetrope/desktop",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:mac": "tauri build --bundles app,dmg",
    "build:mac-universal": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "build:windows": "tauri build --bundles nsis,msi",
    "build:windows-arm": "tauri build --target aarch64-pc-windows-msvc --bundles nsis",
    "build:linux": "tauri build --bundles deb,rpm,appimage",
    "icons": "tauri icon icon-source.png -o src-tauri/icons"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.1.0"
  }
}
