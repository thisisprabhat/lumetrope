{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumetrope",
  "version": "0.1.0",
  "identifier": "app.lumetrope.editor",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../.. --filter lumetrope-mcp build && pnpm --dir ../.. dev",
    "beforeBuildCommand": "pnpm --dir ../.. build"
  },
  "app": {
    "windows": [
      {
        "title": "Lumetrope",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "titleBarStyle": "Visible",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Open-source Lottie & dotLottie animation editor",
    "copyright": "MIT licensed",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "publisher": "Lumetrope contributors",
    "longDescription": "Lumetrope is an open-source creator and editor for Lottie and dotLottie animations, with interactive state machines, local version history and an MCP server for AI agents.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "resources": {
      "../../../packages/mcp/dist/lumetrope-mcp.mjs": "mcp/lumetrope-mcp.mjs"
    }
  }
}
